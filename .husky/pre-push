#!/usr/bin/env bash

# Colors
BOLD='\033[1m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
RESET='\033[0m'

MAIN_BRANCH="main"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo ""
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${BOLD}  Pre-Push Analysis  ${CURRENT_BRANCH} → ${MAIN_BRANCH}${RESET}"
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

# Check claude is available
if ! command -v claude &> /dev/null; then
  echo -e "${RED}Warning: 'claude' CLI not found — skipping AI analysis.${RESET}"
  exit 0
fi

# Get the diff against main
DIFF=$(git diff "${MAIN_BRANCH}...HEAD" 2>/dev/null)

if [ -z "$DIFF" ]; then
  echo -e "No changes detected against ${BOLD}${MAIN_BRANCH}${RESET}. Skipping analysis."
  echo ""
  exit 0
fi

# Temp files
REVIEW_INPUT=$(mktemp)
PR_DESC_INPUT=$(mktemp)
REVIEW_OUTPUT=$(mktemp)
PR_DESC_OUTPUT=$(mktemp)

cleanup() {
  rm -f "$REVIEW_INPUT" "$PR_DESC_INPUT" "$REVIEW_OUTPUT" "$PR_DESC_OUTPUT"
}
trap cleanup EXIT

# ── Code Review Prompt ────────────────────────────────────────────────────────
cat > "$REVIEW_INPUT" << 'PROMPT_END'
You are a senior software engineer conducting a rigorous code review. Analyze the git diff below.

Review for the following, in priority order:

**BUGS** — Logic errors, race conditions, incorrect expiry/retry behavior, data inconsistency, unhandled promise rejections, wrong values passed to functions, off-by-one errors, incorrect assumptions about external API responses.

**INEFFICIENCIES** — N+1 database queries, sequential awaits that should be Promise.all, redundant DB round-trips, heavy objects instantiated per-request when they could be shared, large transactions that could cause lock contention.

**CODE QUALITY** — Dead code, misleading names, missing guard clauses, inconsistency with surrounding patterns, security concerns (unvalidated input at boundaries, injection risk), log messages that misrepresent what happened.

Format each finding as:

**[SEVERITY]** `path/to/file.ts:approx-line`
Problem: one sentence describing the issue.
Fix: one sentence describing the solution.

Severity levels: BUG / INEFFICIENCY / QUALITY

After all findings, add a one-line overall verdict: either "Clean — no significant issues." or a one-sentence summary of the most important thing to fix.

Be concrete. Skip trivial style preferences. If a section has no findings, omit it.

--- GIT DIFF ---
PROMPT_END
echo "$DIFF" >> "$REVIEW_INPUT"

# ── PR Description Prompt ─────────────────────────────────────────────────────
cat > "$PR_DESC_INPUT" << 'PROMPT_END'
You are a staff engineer writing a pull request description. Analyze the git diff below and produce a complete, accurate PR description.

Output exactly the following sections — no preamble, no commentary outside the sections:

## Summary
2-4 sentences. What changed, and the technical or business motivation. Focus on *why*, not just *what*.

## Changes
Bulleted list grouped by concern (e.g. "Data Layer", "Business Logic", "Cron Jobs", "Tests"). Each bullet: what changed + why it matters. Be specific.

## Testing Instructions
Numbered manual testing steps. Cover the happy path and at least one edge/failure case. Specify what to navigate to, what action to take, and what the expected result is.

## Tests Added / Modified
One bullet per test file: the file name and a one-sentence description of what it verifies.

## Architecture
A mermaid diagram that visually depicts the most significant architectural change in this diff. Use `flowchart TD` or `sequenceDiagram` — whichever best illustrates the new data flow or component relationships. Make it accurate to the actual diff, not generic.

--- GIT DIFF ---
PROMPT_END
echo "$DIFF" >> "$PR_DESC_INPUT"

# ── Run both in parallel ──────────────────────────────────────────────────────
echo -e "${BOLD}${YELLOW}⟳  Running code review and PR description in parallel...${RESET}"
echo ""

claude -p "$(cat "$REVIEW_INPUT")" > "$REVIEW_OUTPUT" 2>&1 &
REVIEW_PID=$!

claude -p "$(cat "$PR_DESC_INPUT")" > "$PR_DESC_OUTPUT" 2>&1 &
PR_DESC_PID=$!

wait "$REVIEW_PID"
REVIEW_EXIT=$?

wait "$PR_DESC_PID"
PR_DESC_EXIT=$?

# ── Output: Code Review ───────────────────────────────────────────────────────
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${BOLD}  CODE REVIEW${RESET}"
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
if [ $REVIEW_EXIT -eq 0 ]; then
  cat "$REVIEW_OUTPUT"
else
  echo -e "${RED}Code review failed (exit $REVIEW_EXIT):${RESET}"
  cat "$REVIEW_OUTPUT"
fi
echo ""

# ── Output: PR Description ────────────────────────────────────────────────────
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${BOLD}  PR DESCRIPTION${RESET}"
echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
if [ $PR_DESC_EXIT -eq 0 ]; then
  cat "$PR_DESC_OUTPUT"
else
  echo -e "${RED}PR description failed (exit $PR_DESC_EXIT):${RESET}"
  cat "$PR_DESC_OUTPUT"
fi
echo ""

echo -e "${BOLD}${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${BOLD}${GREEN}  Push proceeding.${RESET}"
echo -e "${BOLD}${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

exit 0
